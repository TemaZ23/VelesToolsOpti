# Ключ Claude API: https://platform.claude.com/settings/keys
# Совет: создайте отдельный workspace с лимитом расходов в консоли — это жёсткий потолок на стороне Anthropic.
ANTHROPIC_API_KEY=

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно. OAuth-токен Freelancer.com (портал разработчика: https://developers.freelancer.com)
